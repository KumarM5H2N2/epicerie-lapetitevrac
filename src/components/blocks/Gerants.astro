---
interface Props {
  titre?: string;
  texte?: string;
  photo?: string;
}

const { titre, texte, photo } = Astro.props;
---

<section class="bg-gradient-to-br from-stone-50 to-stone-100 py-16 px-4 border-t border-b border-stone-200/60">
  <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center gap-12">
    
    <!-- Zone Photo / Avatar par défaut -->
    <div class="w-48 h-48 md:w-64 md:h-64 rounded-full bg-emerald-800/10 border-4 border-white shadow-md flex items-center justify-center flex-shrink-0 overflow-hidden group">
      {photo ? (
        <img src={photo} alt={titre} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
      ) : (
        <span class="text-6xl md:text-7xl select-none filter drop-shadow-sm animate-pulse">🧑‍🌾👩‍🌾</span>
      )}
    </div>

    <!-- Zone Textes -->
    <div class="flex-1 text-center md:text-left">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-3 py-1 rounded-md border border-emerald-200/50">
        Vos Épiciers
      </span>
      <h2 class="text-3xl font-black text-stone-900 tracking-tight mt-3">
        {titre || "Qui se cache derrière le comptoir ?"}
      </h2>
      <p class="text-stone-600 font-medium text-lg leading-relaxed mt-4 whitespace-pre-line">
        {texte}
      </p>
    </div>

  </div>
</section>
