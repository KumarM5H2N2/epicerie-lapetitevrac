---
// 1. Importation directe du fichier JSON de la boutique
import boutiqueData from '../../content/infos/boutique.json';

// 🚀 ON IMPORTE NOTRE COMPOSANT VISUEL GÉRANTS
import Gerants from '../components/blocks/Gerants.astro';

// 🎨 IMPORT DE LA FEUILLE DE STYLE GENERALE
import '../styles/global.css';


// 2. Syntaxe moderne pour Astro v6+ / Vite (Récupération des arrivages)
const modules = import.meta.glob('../../content/arrivages/*.json', { eager: true });
const arrivagesList = Object.values(modules).map((mod: any) => mod.default || mod);





---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{boutiqueData.titre}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <!-- 🛡️ Utilisation exclusive des variables thématiques globales (Pastel Vert/Gris) -->
  <body class="bg-background min-h-screen text-foreground antialiased font-sans">
    
    <!-- 🧭 BARRE DE NAVIGATION ET ONGLETS ACCESSIBLES -->
    <nav class="bg-card border-b border-border shadow-xs relative z-10">
      <div class="max-w-6xl mx-auto px-4 flex items-center justify-between h-16">
        <!-- Logo / Accueil -->
        <a href="/" class="font-black text-primary tracking-tight text-lg hover:opacity-80 transition-opacity flex items-center gap-1.5">
          🍏 {boutiqueData.titre}
        </a>
        <!-- Liens vers vos 3 nouvelles pages -->
        <div class="flex items-center gap-4 sm:gap-6 font-semibold text-muted-foreground text-sm">
          <a href="/" class="text-primary font-bold transition-colors">Accueil</a>
          <a href="/photos-gerants" class="hover:text-primary transition-colors">Photos</a>
          <a href="/evenements" class="hover:text-primary transition-colors">Événements</a>
          <a href="/recettes" class="hover:text-primary transition-colors">Recettes ✨</a>
        </div>
      </div>
    </nav>

    <!-- EN-TÊTE / HERO SECTION (Version adoucie, harmonisée vert sauge pastel) -->
    <header class="bg-gradient-to-br from-[var(--primary)] to-stone-700/40 text-white py-20 px-4 text-center shadow-xs relative">
      <div class="max-w-3xl mx-auto">
        <span class="bg-white/20 text-white font-bold px-4 py-1.5 rounded-full text-xs uppercase tracking-wider border border-white/10 backdrop-blur-xs">
          Épicerie Fine, Bio & Zéro Déchet
        </span>
        <h1 class="text-4xl md:text-6xl font-black mt-4 tracking-tight drop-shadow-xs">
          {boutiqueData.titre}
        </h1>
        <p class="text-lg md:text-xl mt-4 text-emerald-50/90 font-medium max-w-2xl mx-auto leading-relaxed">
          {boutiqueData.description}
        </p>
      </div>
    </header>

    <!-- LES ARRIVAGES DE SAISON -->
    <section class="max-w-6xl mx-auto px-4 py-16 relative">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 border-b border-border pb-5">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight text-foreground">🥬 Les Arrivages de la Semaine</h2>
          <p class="text-muted-foreground mt-1">Des produits frais, bio et rigoureusement sélectionnés pour vous au Pellerin.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {arrivagesList.map((produit) => {
          if (!produit || !produit.title) return null;
          return (
            <div class="bg-card rounded-2xl shadow-xs border border-border overflow-hidden hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
              <div class="p-6">
                <div class="flex items-start justify-between">
                  <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">
                    {produit.title}
                  </h3>
                  {produit.bio && (
                    <span class="bg-[var(--secondary)] text-[var(--secondary-foreground)] font-bold text-xs px-2.5 py-1 rounded-md border border-border uppercase tracking-wide">
                      BIO
                    </span>
                  )}
                </div>
                <p class="text-muted-foreground text-sm mt-2 flex items-center gap-1.5">
                  📍 {produit.origine || "Provenance locale"}
                </p>
              </div>
              <div class="bg-muted/50 px-6 py-4 border-t border-border flex items-center justify-between">
                <span class="text-muted-foreground text-xs font-medium">Prix indicatif</span>
                <span class="text-primary font-extrabold text-lg">{produit.prix}</span>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 🚀 NOTRE SECTION GÉRANTS DE L'ÉPICERIE (Sécurisée) -->
    <Gerants 
      titre={boutiqueData.gerantsTitre} 
      texte={boutiqueData.gerantsTexte} 
      photo={boutiqueData.gerantsPhoto} 
    />

    <!-- 🚚 BLOC FOOD TRUCK TOTALEMENT NETTOYÉ ET ADAPTÉ -->
    <section class="max-w-6xl mx-auto px-4 py-12 relative">
      <div class="bg-muted/40 rounded-2xl p-8 border border-border flex flex-col md:flex-row items-center gap-8">
        <div class="text-4xl p-4 bg-card rounded-xl shadow-xs border border-border shrink-0">
          🚚🍕
        </div>
        <div class="flex-1 text-center md:text-left">
          <span class="bg-primary/20 text-primary font-bold px-3 py-1 rounded-md text-xs uppercase tracking-wider border border-primary/10">
            Animation Parking
          </span>
          <h3 class="text-2xl font-black text-foreground mt-2">
            Le Food Truck de la Semaine !
          </h3>
          <p class="text-muted-foreground font-medium text-base mt-2">
            Pour dynamiser la vie de quartier au Pellerin, un food truck partenaire s'installe régulièrement sur notre parking. Venez faire vos courses de vrac et repartez avec un délicieux repas chaud cuisiné sur place !
          </p>
          <div class="mt-4 flex flex-wrap gap-4 justify-center md:justify-start text-sm font-bold text-foreground">
            <span class="bg-card px-4 py-2 rounded-xl border border-border">📅 Tous les Jeudis soir</span>
            <span class="bg-card px-4 py-2 rounded-xl border border-border">⏱️ 18h30 - 21h30</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FORMULAIRE DE CONTACT GMAIL -->
    <section class="max-w-3xl mx-auto px-4 py-12 bg-card rounded-2xl border border-border shadow-xs my-12 relative">
      <h3 class="text-2xl font-bold text-foreground mb-2 flex items-center gap-2">✉️ Poser une question à l'épicerie</h3>
      <p class="text-muted-foreground text-sm mb-6">Le message tombera directement sur la boîte de réception de l'épicerie.</p>
      
      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
        <input type="hidden" name="access_key" value="5422b57e-2056-437e-b7f1-82a3119db79d" />
        <div>
          <label class="block font-semibold text-muted-foreground text-sm mb-1">Nom / Prénom</label>
          <input type="text" name="name" required class="w-full border border-border rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-[var(--primary)] bg-background text-foreground" />
        </div>
        <div>
          <label class="block font-semibold text-muted-foreground text-sm mb-1">Adresse e-mail</label>
          <input type="email" name="email" required class="w-full border border-border rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-[var(--primary)] bg-background text-foreground" />
        </div>
        <div>
          <label class="block font-semibold text-muted-foreground text-sm mb-1">Votre question</label>
          <textarea name="message" rows="4" required class="w-full border border-border rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-[var(--primary)] bg-background text-foreground"></textarea>
        </div>
        <button type="submit" class="bg-primary text-white font-bold px-6 py-3 rounded-xl hover:opacity-90 transition-opacity w-full shadow-xs">
          Envoyer le message
        </button>
      </form>
    </section>

    <!-- INFOS PRATIQUES & HORAIRES -->
    <section class="bg-muted border-t border-border py-16 px-4 relative">
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        
        <!-- Bloc Horaires -->
        <div class="bg-card p-8 rounded-2xl border border-border shadow-xs">
          <h3 class="text-2xl font-bold text-foreground mb-4 flex items-center gap-2">🕒 Horaires d'Ouverture</h3>
          <p class="whitespace-pre-line text-muted-foreground leading-relaxed font-medium">
            {boutiqueData.horaires}
          </p>
        </div>

        <!-- Bloc Accès / Adresse -->
        <div class="bg-card p-8 rounded-2xl border border-border shadow-xs">
          <h3 class="text-2xl font-bold text-foreground mb-4 flex items-center gap-2">📍 Venir à la Boutique</h3>
          <p class="text-muted-foreground leading-relaxed font-medium mb-6">
            {boutiqueData.adresse}
          </p>
          <a 
            href={boutiqueData.googleMaps} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center bg-primary hover:opacity-90 text-white font-bold px-6 py-3 rounded-xl transition-opacity w-full shadow-xs"
          >
            🗺️ Ouvrir l'itinéraire sur Google Maps
          </a>
        </div>

      </div>
    </section>

  </body>
</html>
