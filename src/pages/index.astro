---
// 1. Importation directe du fichier JSON de la boutique
import boutiqueData from '../../content/infos/boutique.json';

// 🚀 ON IMPORTE NOTRE COMPOSANT VISUEL GÉRANTS
import Gerants from '../components/blocks/Gerants.astro';

// 2. Syntaxe moderne pour Astro v6+ / Vite (Récupération des arrivages)
const modules = import.meta.glob('../../content/arrivages/*.json', { eager: true });
const arrivagesList = Object.values(modules).map((mod: any) => mod.default || mod);
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{boutiqueData.titre}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <!-- 🛡️ Utilisation exclusive des styles de base natifs pour éviter tout blocage de calque -->
  <body class="bg-stone-50 min-h-screen text-stone-800 antialiased font-sans">
    
    <!-- 🧭 BARRE DE NAVIGATION ET ONGLETS ACCESSIBLES (Corrigée : plus de calque bloquant) -->
    <nav class="bg-white border-b border-stone-200 shadow-sm relative z-10">
      <div class="max-w-6xl mx-auto px-4 flex items-center justify-between h-16">
        <!-- Logo / Accueil -->
        <a href="/" class="font-black text-emerald-800 tracking-tight text-lg hover:text-emerald-950 transition-colors flex items-center gap-1.5">
          🍏 {boutiqueData.titre}
        </a>
        <!-- Liens vers vos 3 nouvelles pages -->
        <div class="flex items-center gap-4 sm:gap-6 font-semibold text-stone-600 text-sm">
          <a href="/" class="text-emerald-700 font-bold transition-colors">Accueil</a>
          <a href="/photos-gerants" class="hover:text-emerald-700 transition-colors">Photos</a>
          <a href="/evenements" class="hover:text-emerald-700 transition-colors">Événements</a>
          <a href="/recettes" class="hover:text-emerald-700 transition-colors">Recettes ✨</a>
        </div>
      </div>
    </nav>

    <!-- EN-TÊTE / HERO SECTION (Version stable et douce, style vert maraîcher) -->
    <header class="bg-gradient-to-br from-green-800 to-emerald-950 text-white py-20 px-4 text-center shadow-md relative">
      <div class="max-w-3xl mx-auto">
        <span class="bg-emerald-600/30 text-emerald-300 font-bold px-4 py-1.5 rounded-full text-xs uppercase tracking-wider border border-emerald-500/20">
          Épicerie Fine, Bio & Zéro Déchet
        </span>
        <h1 class="text-4xl md:text-6xl font-black mt-4 tracking-tight drop-shadow-sm">
          {boutiqueData.titre}
        </h1>
        <p class="text-lg md:text-xl mt-4 text-emerald-100 font-medium max-w-2xl mx-auto leading-relaxed">
          {boutiqueData.description}
        </p>
      </div>
    </header>

    <!-- LES ARRIVAGES DE SAISON -->
    <section class="max-w-6xl mx-auto px-4 py-16 relative">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 border-b border-stone-200 pb-5">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight text-stone-900">🥬 Les Arrivages de la Semaine</h2>
          <p class="text-stone-500 mt-1">Des produits frais, bio et rigoureusement sélectionnés pour vous au Pellerin.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {arrivagesList.map((produit) => {
          if (!produit || !produit.title) return null;
          return (
            <div class="bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
              <div class="p-6">
                <div class="flex items-start justify-between">
                  <h3 class="text-xl font-bold text-stone-900 group-hover:text-green-700 transition-colors">
                    {produit.title}
                  </h3>
                  {produit.bio && (
                    <span class="bg-green-100 text-green-800 font-bold text-xs px-2.5 py-1 rounded-md border border-green-200 uppercase tracking-wide">
                      BIO
                    </span>
                  )}
                </div>
                <p class="text-stone-500 text-sm mt-2 flex items-center gap-1.5">
                  📍 {produit.origine || "Provenance locale"}
                </p>
              </div>
              <div class="bg-stone-50 px-6 py-4 border-t border-stone-100 flex items-center justify-between">
                <span class="text-stone-400 text-xs font-medium">Prix indicatif</span>
                <span class="text-emerald-700 font-extrabold text-lg">{produit.prix}</span>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 🚀 NOTRE SECTION GÉRANTS DE L'ÉPICERIE (Sécurisée) -->
    <Gerants 
      titre={boutiqueData.gerantsTitre} 
      texte={boutiqueData.gerantsTexte} 
      photo={boutiqueData.gerantsPhoto} 
    />

    <!-- 🚚 BLOC FOOD TRUCK TOTALEMENT NETTOYÉ DE SES CLASSES BLOQUANTES -->
    <section class="max-w-6xl mx-auto px-4 py-12 relative">
      <div class="bg-amber-50 rounded-2xl p-8 border border-amber-200 flex flex-col md:flex-row items-center gap-8">
        <div class="text-4xl p-4 bg-white rounded-xl shadow-xs border border-amber-200 shrink-0">
          🚚🍕
        </div>
        <div class="flex-1 text-center md:text-left">
          <span class="bg-amber-200 text-amber-900 font-bold px-3 py-1 rounded-md text-xs uppercase tracking-wider">
            Animation Parking
          </span>
          <h3 class="text-2xl font-black text-stone-900 mt-2">
            Le Food Truck de la Semaine !
          </h3>
          <p class="text-stone-600 font-medium text-base mt-2">
            Pour dynamiser la vie de quartier au Pellerin, un food truck partenaire s'installe régulièrement sur notre parking. Venez faire vos courses de vrac et repartez avec un délicieux repas chaud cuisiné sur place !
          </p>
          <div class="mt-4 flex flex-wrap gap-4 justify-center md:justify-start text-sm font-bold text-amber-950">
            <span class="bg-white px-4 py-2 rounded-xl border border-amber-200">📅 Tous les Jeudis soir</span>
            <span class="bg-white px-4 py-2 rounded-xl border border-amber-200">⏱️ 18h30 - 21h30</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FORMULAIRE DE CONTACT GMAIL -->
    <section class="max-w-3xl mx-auto px-4 py-12 bg-white rounded-2xl border border-stone-200 shadow-sm my-12 relative">
      <h3 class="text-2xl font-bold text-stone-900 mb-2 flex items-center gap-2">✉️ Poser une question à l'épicerie</h3>
      <p class="text-stone-500 text-sm mb-6">Le message tombera directement sur la boîte de réception de l'épicerie.</p>
      
      <form action="https://web3forms.com" method="POST" class="space-y-4">
        <input type="hidden" name="access_key" value="5422b57e-2056-437e-b7f1-82a3119db79d" />
        <div>
          <label class="block font-semibold text-stone-700 text-sm mb-1">Nom / Prénom</label>
          <input type="text" name="name" required class="w-full border border-stone-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-green-600 bg-stone-50" />
        </div>
        <div>
          <label class="block font-semibold text-stone-700 text-sm mb-1">Adresse e-mail</label>
          <input type="email" name="email" required class="w-full border border-stone-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-green-600 bg-stone-50" />
        </div>
        <div>
          <label class="block font-semibold text-stone-700 text-sm mb-1">Votre question</label>
          <textarea name="message" rows="4" required class="w-full border border-stone-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-green-600 bg-stone-50"></textarea>
        </div>
        <button type="submit" class="bg-green-700 text-white font-bold px-6 py-3 rounded-xl hover:bg-green-800 transition-colors w-full shadow-sm">
          Envoyer le message
        </button>
      </form>
    </section>

    <!-- INFOS PRATIQUES & HORAIRES -->
    <section class="bg-stone-100 border-t border-stone-200 py-16 px-4 relative">
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        
        <!-- Bloc Horaires -->
        <div class="bg-white p-8 rounded-2xl border border-stone-200 shadow-sm">
          <h3 class="text-2xl font-bold text-stone-900 mb-4 flex items-center gap-2">🕒 Horaires d'Ouverture</h3>
          <p class="whitespace-pre-line text-stone-600 leading-relaxed font-medium">
            {boutiqueData.horaires}
          </p>
        </div>

        <!-- Bloc Accès / Adresse -->
        <div class="bg-white p-8 rounded-2xl border border-stone-200 shadow-sm">
          <h3 class="text-2xl font-bold text-stone-900 mb-4 flex items-center gap-2">📍 Venir à la Boutique</h3>
          <p class="text-stone-600 leading-relaxed font-medium mb-6">
            {boutiqueData.adresse}
          </p>
          <a 
            href={boutiqueData.googleMaps} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center bg-green-700 hover:bg-green-800 text-white font-bold px-6 py-3 rounded-xl transition-colors w-full shadow-sm"
          >
            🗺️ Ouvrir l'itinéraire sur Google Maps
          </a>
        </div>

      </div>
    </section>

  </body>
</html>
