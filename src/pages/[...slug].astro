---
import Base from '../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../components/islands/PageBody.astro';
import { getConfig, getPage, listPages } from '../lib/data';
import { islands } from '../lib/islands';
// 🚀 1. IMPORTATION DIRECTE DU FICHIER DE DONNÉES DES GÉRANTS
import boutiqueData from '../../content/infos/boutique.json';
// 🚀 2. IMPORTATION DU COMPOSANT VISUEL DES GÉRANTS
import Gerants from '../components/blocks/Gerants.astro';

export async function getStaticPaths() {
	const pages = await listPages();
	return pages
		.map((node) => node._sys.filename)
		.filter((slug) => slug !== 'home')
		.map((slug) => ({ params: { slug } }));
}

const slug = (Astro.params.slug ?? '').toString();
const page = await getPage(slug);
const data = page.data?.page;
if (!data) return new Response('Not Found', { status: 404 });
const config = (await getConfig()).data?.config ?? null;
---

<Base
	title={data.seoTitle || config?.seo?.title || 'TinaCMS + Astro'}
	description={config?.seo?.description ?? 'Welcome to my website!'}
>
	<TinaIsland name="page" wrapper={islands.page.wrapper} params={{ slug }} primary>
		<PageBody data={data} />
	</TinaIsland>

	<!-- 🚀 3. AFFICHAGE DE LA SECTION DES GÉRANTS TOUT EN BAS DE LA PAGE -->
	<Gerants 
		titre={boutiqueData.gerantsTitre} 
		texte={boutiqueData.gerantsTexte} 
		photo={boutiqueData.gerantsPhoto} 
	/>
</Base>
